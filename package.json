{
  "name": "@y-tinypool/monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "turbo run bench",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write '**/*.{ts,js,mjs}'",
    "release": "bumpp package.json packages/*/package.json --commit --push --tag",
    "test:ci": "turbo run test:ci",
    "typecheck": "turbo run typecheck",
    "preversion": "turbo run test:ci"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "bumpp": "latest",
    "prettier": "^3.9.5",
    "tsdown": "^0.21.10",
    "tsx": "^4.21.0",
    "turbo": "^2.9.9",
    "typescript": "^5.9.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=v20.10.0"
  }
}
